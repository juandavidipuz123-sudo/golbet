@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model GolBet.Services.DTOs.MatchDetailDto

@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-action="Index">Partidos</a>
        </li>
        <li class="breadcrumb-item active">
            @Model.HomeTeamName vs @Model.AwayTeamName
        </li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <small class="text-muted">
            📅 @Model.Date.ToColombiaTime().ToString("dddd dd MMM yyyy · h:mm tt")
        </small>
        @switch (Model.Status)
        {
            case MatchStatus.Scheduled:
                <span class="badge bg-primary">Programado</span>
                break;
            case MatchStatus.InProgress:
                <span class="badge bg-warning text-dark">En juego</span>
                break;
            case MatchStatus.Finished:
                <span class="badge bg-secondary">Finalizado</span>
                break;
        }
    </div>

    <div class="card-body text-center">
        <div class="d-flex justify-content-between align-items-center">
            <div class="w-100">
                <img src="@(Model.HomeTeamCrestUrl ?? "https://placehold.co/100x100/e9ecef/6c757d?text=FC")"
                     alt="@Model.HomeTeamName" width="100" height="100" class="mb-2" />
                <div class="fw-bold">@Model.HomeTeamName</div>
            </div>

            <div class="px-4 text-nowrap">
                @if (Model.Status == MatchStatus.Finished)
                {
                    <span class="fs-2 fw-bold">@Model.HomeGoals-@Model.AwayGoals</span>
                }
                else
                {
                    <span class="fs-4 text-muted">vs</span>
                }
            </div>

            <div class="w-100">
                <img src="@(Model.AwayTeamCrestUrl ?? "https://placehold.co/100x100/e9ecef/6c757d?text=FC")"
                     alt="@Model.AwayTeamName" width="100" height="100" class="mb-2" />
                <div class="fw-bold">@Model.AwayTeamName</div>
            </div>
        </div>

        <hr />

        <div class="row g-2 text-center mb-3">
            <div class="col">
                <div class="border rounded py-2">
                    <small class="text-muted d-block">1 · @Model.HomeTeamName</small>
                    <span class="fw-bold">@Model.HomeOdds.ToString("0.00")</span>
                </div>
            </div>
            <div class="col">
                <div class="border rounded py-2">
                    <small class="text-muted d-block">X · Empate</small>
                    <span class="fw-bold">@Model.DrawOdds.ToString("0.00")</span>
                </div>
            </div>
            <div class="col">
                <div class="border rounded py-2">
                    <small class="text-muted d-block">2 · @Model.AwayTeamName</small>
                    <span class="fw-bold">@Model.AwayOdds.ToString("0.00")</span>
                </div>
            </div>
        </div>

        <p class="text-muted mb-3">@Model.TotalBets apuestas realizadas</p>

        @if (Model.Status == MatchStatus.Scheduled)
        {
            <button class="btn btn-success"
                    disabled
                    title="Disponible cuando implementemos las apuestas">
                Apostar (Pendiente por codear)
            </button>
        }
    </div>
</div>
